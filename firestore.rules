rules_version = '2';

// ============================================================
// sportcenter-manager — Security Rules
//
// Modello: ogni utente ha un documento in /users/{uid} con ruoloId.
// Il ruolo (/roles/{ruoloId}) contiene un array "permessi" (stringhe),
// oppure ["*"] per admin con accesso completo.
//
// Le rules leggono il documento utente/ruolo dell'utente autenticato
// per decidere se un permesso è presente (get() dentro alle rules).
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function roleDoc() {
      return get(/databases/$(database)/documents/roles/$(userDoc().data.ruoloId));
    }

    function hasPermission(perm) {
      return isSignedIn()
        && userDoc().data.attivo != false
        && (
          roleDoc().data.permessi.hasAny([perm])
          || roleDoc().data.permessi.hasAny(["*"])
        );
    }

    // Vero amministratore (ruolo con permesso "*"), a differenza di
    // hasPermission() che per costruzione ritorna sempre true per l'admin
    // qualunque permesso specifico si chieda — qui serve invece distinguere
    // "ha un permesso ampio come diario:gestisci_tutti" da "è davvero
    // l'amministratore", per le voci diario già approvate (vedi sotto).
    function isAdmin() {
      return isSignedIn() && userDoc().data.attivo != false && roleDoc().data.permessi.hasAny(["*"]);
    }

    // prenotazioni:gestisci (tutto, incluse le prenotazioni altrui) o
    // prenotazioni:proprie (es. maestri: solo le proprie + blocchi) —
    // entrambi devono poter vedere il tabellone operatore completo.
    function puoOperarePrenotazioni() {
      return hasPermission("prenotazioni:gestisci") || hasPermission("prenotazioni:proprie");
    }

    // Ogni utente può leggere il proprio profilo; l'admin (users:gestisci)
    // tutti; chi ha "diario:leggi_tutti" può leggere tutti gli utenti
    // (serve al Resoconto per calcolare quota campo e compenso per
    // dipendente), ma non modificarli.
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId
        || hasPermission("users:gestisci")
        || hasPermission("diario:leggi_tutti")
      );
      allow write: if hasPermission("users:gestisci");
    }

    // I ruoli sono leggibili da chi è loggato (servono per calcolare i permessi),
    // ma modificabili solo da chi gestisce i ruoli.
    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if hasPermission("ruoli:gestisci");
    }

    // Minuti entro cui un dipendente può eliminare una propria voce diario
    // (impostazioni/generale.minutiEliminazioneDiario, configurabile da
    // Configurazione); 15 di default se il documento non esiste ancora.
    function minutiEliminazioneDiario() {
      return exists(/databases/$(database)/documents/impostazioni/generale)
        ? get(/databases/$(database)/documents/impostazioni/generale).data.minutiEliminazioneDiario
        : 15;
    }

    // Diario giornaliero:
    // - un dipendente può creare/leggere/modificare solo le proprie voci (userId == uid)
    // - un dipendente può eliminare una propria voce solo entro
    //   minutiEliminazioneDiario() dalla creazione
    // - chi ha "diario:leggi_tutti" può leggere le voci di chiunque
    // - chi ha "diario:gestisci_tutti" può modificare/cancellare voci altrui
    //   e cancellare oltre il limite di tempo (es. admin, supervisore)
    // - chi ha "diario:approva" può approvare voci altrui (stesso pattern di
    //   corsi:approva — permesso di update pieno, non limitato ai soli campi
    //   di approvazione, come già per i corsi)
    // - una volta approvata (approvato == true), la voce si blocca per
    //   chiunque tranne il vero amministratore (isAdmin(), non semplicemente
    //   diario:gestisci_tutti) — richiesto esplicitamente: "non modificabile
    //   se non dall'amministratore" dopo l'approvazione del responsabile.
    // - i campi "pagamentoOnline*" (esito di un pagamento richiesto tramite
    //   PostFinance, vedi richiediPagamentoDiario) li scrive SOLO la Cloud
    //   Function via Admin SDK (bypassa queste regole) — un update client
    //   "normale" non può toccarli, altrimenti chiunque potrebbe segnare
    //   una propria lezione come pagata senza che lo sia davvero.
    function nonToccaCampiPagamentoOnline() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'pagamentoOnlineStato', 'pagamentoOnlineToken', 'pagamentoOnlineImporto',
        'pagamentoOnlineLink', 'pagamentoOnlineDescrizione',
        'pagamentoOnlineRichiestoDaUid', 'pagamentoOnlineRichiestoDaNome',
        'pagamentoOnlineRichiestoAt', 'pagamentoOnlinePagatoAt'
      ]);
    }

    match /diario/{entryId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;

      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || hasPermission("diario:leggi_tutti")
        || hasPermission("diario:approva")
      );

      allow update: if isAdmin() || (
        resource.data.approvato != true
        && nonToccaCampiPagamentoOnline()
        && (
          resource.data.userId == request.auth.uid
          || hasPermission("diario:gestisci_tutti")
          || hasPermission("diario:approva")
        )
      );

      allow delete: if isAdmin() || (
        resource.data.approvato != true
        && (
          hasPermission("diario:gestisci_tutti")
          || (
            resource.data.userId == request.auth.uid
            && resource.data.createdAt > request.time - duration.value(minutiEliminazioneDiario(), 'm')
          )
        )
      );
    }

    // Configurazione (pannello "Configurazione"): tipi utenza, campi, tipi
    // gruppo padel, tipi attività con tariffe. Lettura aperta a chiunque sia
    // loggato (servono per i menu a tendina del diario), scrittura riservata
    // a chi ha il permesso "config:gestisci".
    match /tipiUtenza/{id} {
      allow read: if isSignedIn();
      allow write: if hasPermission("config:gestisci");
    }

    match /campi/{id} {
      allow read: if isSignedIn();
      allow write: if hasPermission("config:gestisci");
    }

    match /tipiGruppoPadel/{id} {
      allow read: if isSignedIn();
      allow write: if hasPermission("config:gestisci");
    }

    match /tipiAttivita/{id} {
      allow read: if isSignedIn();
      allow write: if hasPermission("config:gestisci");
    }

    // Allievi: anagrafica nomi per la fatturazione (es. sparring). Chiunque
    // loggato può leggerli e crearne di nuovi al volo dal diario; solo
    // config:gestisci può rinominarli/disattivarli/eliminarli.
    match /allievi/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if hasPermission("config:gestisci");
    }

    // Discipline (tennis, padel, squash, e altre configurabili come
    // preparatore atletico, sparring, mental coach...). Lettura pubblica
    // (non sono dati sensibili: sono solo le etichette "Tennis"/"Padel"
    // già mostrate nella pagina pubblica di iscrizione, che essendo senza
    // login non potrebbe altrimenti leggerle — stesso ragionamento già
    // fatto per "corsi"). Scrittura riservata a config:gestisci.
    match /discipline/{id} {
      allow read: if true;
      allow write: if hasPermission("config:gestisci");
    }

    // Quote campo: importo dovuto dal collaboratore al circolo per l'uso
    // del campo, in base a disciplina/posizione/periodo (e per il padel
    // durata+fascia oraria). Stesso pattern di lettura/scrittura delle
    // altre collection di configurazione.
    match /quoteCampo/{id} {
      allow read: if isSignedIn();
      allow write: if hasPermission("config:gestisci");
    }

    // Cassa/Bar: catalogo articoli in vendita (gestito come le altre
    // collection di configurazione) e le vendite registrate, riservate
    // a chi ha il permesso "vendite:gestisci" (es. ruolo Bar).
    match /articoli/{id} {
      allow read: if isSignedIn();
      allow write: if hasPermission("config:gestisci");
    }

    match /vendite/{id} {
      allow read, write: if hasPermission("vendite:gestisci");
    }

    // Impostazioni generali (doc "generale": minutiEliminazioneDiario; doc
    // "tariffePadel": prezzi campo). Lettura pubblica perché la pagina
    // pubblica di prenotazione padel, senza login, deve poter mostrare il
    // prezzo prima del pagamento — non sono dati sensibili (stesso
    // ragionamento già fatto per "corsi" e "discipline").
    match /impostazioni/{id} {
      allow read: if true;
      allow write: if hasPermission("config:gestisci");
    }

    // Corsi: lettura pubblica (il modulo di iscrizione, senza login, deve
    // poter mostrare i corsi aperti — non sono dati sensibili, sono
    // informazioni che vogliamo mostrare agli interessati). Scrittura
    // riservata a chi crea/modifica i corsi o a chi li approva.
    match /corsi/{id} {
      allow read: if true;
      allow create, update: if hasPermission("corsi:gestisci") || hasPermission("corsi:approva");
      allow delete: if hasPermission("corsi:gestisci");
    }

    // Iscrizioni corsi (fase 2): form pubblico, nessun login richiesto per
    // iscriversi — la creazione è quindi validata qui invece che sul solito
    // controllo isSignedIn(): deve puntare a un corso esistente e già
    // approvato, avere i campi minimi e partire sempre come "in_attesa"
    // (non può auto-confermarsi). Contiene dati sensibili (anagrafica,
    // contatti) quindi lettura/gestione riservata al permesso dedicato
    // iscrizioni:gestisci — non isSignedIn() generico come il resto dell'app.
    // Email validata col formato (qualcosa@qualcosa.qualcosa) — controlla
    // solo che sia scritta bene, non che esista davvero/riceva posta (per
    // quello servirebbe un invio di conferma, non ancora previsto).
    function emailValida(email) {
      return email is string && email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    match /iscrizioniCorsi/{id} {
      allow create: if request.resource.data.corsoId is string
        && exists(/databases/$(database)/documents/corsi/$(request.resource.data.corsoId))
        && get(/databases/$(database)/documents/corsi/$(request.resource.data.corsoId)).data.approvato == true
        && request.resource.data.nome is string && request.resource.data.nome.size() > 0
        && request.resource.data.cognome is string && request.resource.data.cognome.size() > 0
        && emailValida(request.resource.data.email)
        // Contatto genitore obbligatorio solo per i minorenni (fino a 17
        // anni): l'età viene calcolata lato client dalla data di nascita
        // e inviata come campo "eta" — un valore falsato non aggira nulla
        // di sensibile, nel peggiore dei casi lo staff nota poi dalla
        // dataNascita reale che manca il contatto e lo richiede a parte.
        && request.resource.data.eta is int
        && (
          request.resource.data.eta >= 18
          || (
            request.resource.data.nomeGenitore is string && request.resource.data.nomeGenitore.size() > 0
            && request.resource.data.telefonoGenitore is string && request.resource.data.telefonoGenitore.size() > 0
          )
        )
        && request.resource.data.stato == "in_attesa";
      allow read, update, delete: if hasPermission("iscrizioni:gestisci");
    }

    // Storico azioni sulle iscrizioni corsi (semafori, conferme, rifiuti,
    // riassegnazioni): registro immutabile per ricostruire cosa è successo
    // in caso di errori di organizzazione/attribuzione — niente update né
    // delete, nemmeno per chi ha iscrizioni:gestisci, altrimenti non
    // sarebbe più uno storico affidabile.
    match /iscrizioniLog/{id} {
      allow read, create: if hasPermission("iscrizioni:gestisci");
    }

    // ============================================================
    // Prenotazione padel pubblica (senza login) con pagamento reale:
    // tutte le scritture passano da Cloud Functions con Admin SDK, che
    // bypassa queste regole — qui sotto ci sono SOLO permessi di lettura,
    // mai di scrittura diretta dal client. (La vecchia collection
    // "prenotazioniPadel", flusso interno pre-apertura pubblica con
    // scrittura diretta dal client, è stata rimossa insieme alla Cloud
    // Function corrispondente — non più collegata a nessuna pagina, e
    // senza il controllo anti-sovrapposizione delle funzioni attuali.)
    // ============================================================

    // Solo i campi pubblici (niente nome/telefono/email/codice): serve al
    // tabellone pubblico e al calcolo degli slot liberi lato client.
    match /bookings/{id} {
      allow get, list: if true;
      allow write: if false;
    }

    // L'ID del documento È il token privato lungo e casuale: conoscerlo
    // (dal link o dal QR) è di per sé l'autorizzazione a leggere QUEL
    // biglietto (allow get). Non deve però essere possibile interrogare
    // la collection ed enumerare i biglietti di tutti — quello resta
    // riservato al pannello operatore (allow list).
    match /bookingTickets/{token} {
      allow get: if true;
      allow list: if puoOperarePrenotazioni();
      allow write: if false;
    }

    // Indice codice breve → prenotazione, per la ricerca manuale
    // dell'operatore (secondo livello di verifica al campo, se il QR non
    // funziona). Il codice si comunica di persona, non va reso
    // interrogabile pubblicamente.
    match /bookingCodes/{code} {
      allow get, list: if puoOperarePrenotazioni();
      allow write: if false;
    }

    // Motivo di un blocco slot (manutenzione, evento/torneo) e chi ha
    // creato la prenotazione (blocco o esente) — separato da "bookings"
    // per non esporre pubblicamente un testo libero interno o l'identità
    // di chi prenota; solo il pannello operatore lo legge. Chi ha solo
    // prenotazioni:proprie lo usa anche per capire quali prenotazioni
    // sono "sue" (createdByUid) e quindi eliminabili.
    match /blockDetails/{bookingId} {
      allow get, list: if puoOperarePrenotazioni();
      allow write: if false;
    }

    // Giorni di chiusura totale del campo (doc ID = data ISO): lettura
    // pubblica perché anche la pagina di prenotazione senza login deve
    // sapere quali date non sono prenotabili; scrittura riservata a chi
    // gestisce le prenotazioni (non ai maestri con prenotazioni:proprie —
    // è una decisione del circolo, non del singolo maestro).
    match /chiusurePadel/{data} {
      allow read: if true;
      allow write: if hasPermission("prenotazioni:gestisci");
    }

    match /payments/{id} {
      allow get, list: if hasPermission("prenotazioni:gestisci");
      allow write: if false;
    }

    // Il credito generato da un annullamento o da un buono regalo (campo
    // "origine": assente = da annullamento, "voucher_acquistato" o
    // "voucher_omaggio" = buono regalo); l'uso da parte del cliente passa
    // sempre da una Cloud Function (mai lettura/scrittura diretta), quindi
    // qui basta il permesso per il pannello operatore.
    match /credits/{code} {
      allow get, list: if hasPermission("prenotazioni:gestisci");
      allow write: if false;
    }

    // Log immutabile dei movimenti di credito — stesso pattern di
    // iscrizioniLog: niente update né delete, nemmeno per l'operatore.
    match /creditTransactions/{id} {
      allow get, list: if hasPermission("prenotazioni:gestisci");
      allow write: if false;
    }

    // "Ricevuta" pubblica di un buono regalo appena acquistato/emesso —
    // stesso pattern di bookingTickets: l'ID del documento È il token
    // lungo e casuale, conoscerlo è di per sé l'autorizzazione a leggere
    // QUEL buono (allow get), ma non a enumerarli tutti (allow list
    // riservato al pannello operatore). Il codice credito vero e proprio
    // resta in "credits", mai esposto pubblicamente per codice breve.
    match /voucherTickets/{token} {
      allow get: if true;
      allow list: if hasPermission("prenotazioni:gestisci");
      allow write: if false;
    }

    // Richiesta di pagamento online generica (oggi solo per lezioni
    // diario, in futuro anche quota campo/cassa — campo "tipo" a
    // distinguerle). L'ID del documento È il token lungo e casuale: la
    // pagina di conferma pubblica lo legge per mostrare l'esito, ma non
    // deve essere enumerabile (allow list riservato a chi gestisce).
    // Scritta solo dalla Cloud Function (Admin SDK).
    match /paymentRequests/{token} {
      allow get: if true;
      allow list: if hasPermission("diario:leggi_tutti") || hasPermission("diario:gestisci_tutti");
      allow write: if false;
    }

    // ============================================================
    // Prenotazione campi tennis/squash con tariffe a categoria e
    // riconoscimento del dispositivo (nessun account tradizionale):
    // stesso principio del padel, "tutte le scritture passano da Cloud
    // Function con Admin SDK" — qui solo permessi di lettura.
    // ============================================================

    // Anagrafica soci importata dal gestionale attuale: contiene email e
    // dati personali, e determina la tariffa applicata — non deve MAI
    // essere leggibile dal client (né il singolo profilo né, tanto meno,
    // l'intera lista). Solo le Cloud Functions (Admin SDK) la leggono,
    // per la verifica email/QR e la ricerca del secondo giocatore.
    match /soci/{id} {
      allow read, write: if false;
    }

    // Collega una sessione Firebase Auth (link email o QR staff) ai
    // profili soci agganciati su quel dispositivo — un dispositivo di
    // famiglia può avere più profili. Solo il proprietario della sessione
    // può leggere i propri; scrittura solo da Cloud Function.
    match /sociDevices/{authUid} {
      allow get: if isSignedIn() && request.auth.uid == authUid;
      allow write: if false;
    }

    // Token di attivazione di un dispositivo (via email inviata dalla
    // Cloud Function, o via QR generato dallo staff in reception per chi
    // non ha email/è Studente/Azienda partner): stesso pattern di
    // bookingTickets, l'ID del documento È il token, conoscerlo (dal link
    // o dal QR) è l'autorizzazione a consumarlo — non a enumerarli.
    match /attivazioniSoci/{token} {
      allow get: if true;
      allow list: if puoOperarePrenotazioni();
      allow write: if false;
    }

    // Tariffe e periodo forfait per campo/categoria/tipo giorno: lettura
    // pubblica (la pagina di prenotazione senza login deve mostrare il
    // prezzo prima del pagamento, stesso ragionamento di tariffePadel).
    match /tariffeCampi/{id} {
      allow read: if true;
      allow write: if hasPermission("config:gestisci");
    }

    match /forfaitCampi/{id} {
      allow read: if true;
      allow write: if hasPermission("config:gestisci");
    }

    // Nome del prenotante e del secondo giocatore (tennis) + dettaglio
    // prezzo: separati da "bookings" apposta, perché "bookings" è
    // leggibile da chiunque (serve al calcolo pubblico degli slot liberi)
    // e questi dati non devono esserlo — solo lo staff li legge
    // direttamente, il pubblico li vede (nomi soltanto) tramite la
    // funzione dettagliGiocatori, che applica il proprio controllo
    // "dispositivo riconosciuto" invece di questa regola.
    match /bookingDettagli/{bookingId} {
      allow get, list: if puoOperarePrenotazioni();
      allow write: if false;
    }

    // Giorni di chiusura di tutto il centro (o solo di alcune discipline):
    // lettura pubblica per lo stesso motivo di chiusurePadel, di cui è
    // il complemento centro-wide (non la sostituisce).
    match /chiusureCentro/{data} {
      allow read: if true;
      allow write: if hasPermission("config:gestisci");
    }

    // Placeholder per collezioni future (camp): aggiungere qui blocchi
    // match dedicati man mano che si sviluppano le pagine, seguendo lo
    // stesso pattern basato su hasPermission().
  }
}
