rules_version = '2';

// Solo immagini caricate da Configurazione (foto disciplina, foto
// sponsor): lettura pubblica perché mostrate sulle pagine pubbliche di
// prenotazione (tcm.html), senza login — stesso ragionamento già fatto
// per le collection Firestore "discipline"/"impostazioni". Scrittura
// riservata allo staff autenticato: l'accesso alla UI di caricamento è
// già filtrato da Configurazione (permesso config:gestisci), qui basta
// escludere gli anonimi.
service firebase.storage {
  match /b/{bucket}/o {
    match /discipline/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /sponsor/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
